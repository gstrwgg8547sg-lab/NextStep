{
  "name": "nextstep",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/parse-decision/index.ts supabase/functions/analyze-decision/index.ts",
    "test:edge": "deno test --allow-env --config supabase/functions/deno.json supabase/functions/_shared/handler_test.ts",
    "format": "prettier --write src supabase/functions tests *.json *.ts *.mts *.mjs docs README.md"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socks-proxy-agent": "^10.1.0",
    "tailwind-merge": "3.7.0",
    "undici": "^8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "deno": "2.9.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}

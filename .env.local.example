# Next.js browser-visible configuration ONLY. Never put a service-role or AI key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ANON_KEY accepts the project's publishable key or legacy anon key.
# AI_API_KEY / AI_BASE_URL / AI_MODEL belong in Supabase Secrets: supabase/.env.example

# Supabase Secrets only: optional per-stage model overrides
AI_PARSE_MODEL=kimi-k2.6
AI_ANALYZE_MODEL=kimi-k2.6
